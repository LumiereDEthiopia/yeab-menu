# Port the server listens on. Railway injects PORT automatically in Docker deploys.
PORT=8080

# Secret used to sign admin JWTs — HIGHLY RECOMMENDED.
# If this is left unset the server generates a random secret at each boot, so it
# is safe but every restart (including Railway redeploys) logs all admins out.
# Generate a strong one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="change-me-to-a-long-random-string"

# Admin login for /admin — HIGHLY RECOMMENDED.
# These default to admin / admin, so the panel works out of the box, but on a
# public deployment that means anyone who guesses the URL can edit the catalog.
# The server logs a warning at startup but never refuses to boot over this.
# Set them in your host's dashboard (Railway -> service -> Variables): this
# file is gitignored and .dockerignored, so it never reaches the container.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin"

# Where the SQLite DB + backups live.
# Windows default: %LOCALAPPDATA%\LumiereMenu — Linux/Docker: ~/.lumiere-menu.
# Set this to a MOUNTED VOLUME or the catalog is deleted on every redeploy
# (Railway: Service → Volumes → + New Volume, mount at /data). The Dockerfile
# already defaults to /data. The server warns but does not refuse to start.
# LUMIERE_DATA_DIR="/data"

# Optional: where automated backups are written. Defaults to
# <LUMIERE_DATA_DIR>/backups. Point this at a SEPARATE volume / off-container
# location so backups survive a loss of the primary volume.
# LUMIERE_BACKUP_DIR="/backups"

