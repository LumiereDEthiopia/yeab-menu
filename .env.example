# Port the server listens on. Railway injects PORT automatically in Docker deploys.
PORT=8080

# Secret used to sign admin JWTs — REQUIRED IN PRODUCTION.
# The server refuses to start in production without it (and rejects the dev value).
# Generate a strong one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="change-me-to-a-long-random-string"

# Admin login for /admin — REQUIRED IN PRODUCTION.
# Local development falls back to admin / admin, so you can leave these alone
# for `npm run dev`. In production the server REFUSES TO START with the default
# admin/admin pair — defining the variables is not enough, they must hold your
# own values. Set them in your host's dashboard (Railway -> service -> Variables),
# NOT here: this file is gitignored and .dockerignored, so it never reaches the
# deployed container.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin"

# Where the SQLite DB + backups live.
# Windows default: %LOCALAPPDATA%\LumiereMenu — Linux/Docker: ~/.lumiere-menu.
# REQUIRED IN PRODUCTION. The server refuses to start without it.
# Point it at a MOUNTED VOLUME (Railway: Service → Volumes → + New Volume,
# mount at /data), e.g. LUMIERE_DATA_DIR=/data
# LUMIERE_DATA_DIR="/data"

# Optional: where automated backups are written. Defaults to
# <LUMIERE_DATA_DIR>/backups. Point this at a SEPARATE volume / off-container
# location so backups survive a loss of the primary volume.
# LUMIERE_BACKUP_DIR="/backups"

