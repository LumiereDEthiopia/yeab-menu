  "private": true,
  "description": "Digital perfume menu for Lumiere — React + Express + SQLite",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx server.ts",
